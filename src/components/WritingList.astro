---
/**
 * A list of essays with date and summary, used on the home page and /writing.
 */
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  essays: CollectionEntry<'writing'>[];
  /** Heading level for each title, so the page's heading outline stays in order. */
  headingLevel?: 'h2' | 'h3';
}

const { essays, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="writing-list">
  {
    essays.map((essay) => (
      <li class="writing-list__item" data-topics={essay.data.topics.join(' ')}>
        <time class="meta" datetime={essay.data.date.toISOString().slice(0, 10)}>
          {formatDate(essay.data.date)}
        </time>
        <Heading class="writing-list__title">
          <a href={`/writing/${essay.id}`}>
            {essay.data.title}
            {essay.data.draft && <span class="meta"> (draft)</span>}
          </a>
        </Heading>
        <p class="writing-list__summary">{essay.data.summary}</p>
      </li>
    ))
  }
</ul>

<style>
  .writing-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .writing-list__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--content-width);
  }

  .writing-list__title {
    font-size: var(--text-md);
  }

  .writing-list__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .writing-list__title a:hover {
    color: var(--color-accent);
  }

  .writing-list__summary {
    color: var(--color-text-muted);
  }
</style>
