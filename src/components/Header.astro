---
/**
 * Site header: name on the left, navigation on the right.
 * The current section is marked with aria-current so it is announced
 * by screen readers and can be styled.
 */
import ThemeToggle from './ThemeToggle.astro';
import { site, navLinks } from '../site';

const currentPath = Astro.url.pathname;

/** True when `href` is the current page or one of its children. */
function isCurrent(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="/">
      {site.name}
      {
        site.nameZh && (
          <span class="site-header__name-zh" lang="zh">
            {site.nameZh}
          </span>
        )
      }
    </a>
    <nav aria-label="Main">
      <ul class="site-nav">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
  }

  .site-header__name {
    margin-right: auto; /* pushes the nav and toggle to the right */
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__name-zh {
    margin-left: var(--space-2);
    color: var(--color-text-muted);
  }

  /*
    Phones: name and theme toggle share the first row, the nav takes the second.
    Wider screens: everything sits on one row, with the toggle last.
  */
  .site-header nav {
    order: 3;
    flex-basis: 100%;
  }

  @media (min-width: 40em) {
    .site-header nav {
      order: 0;
      flex-basis: auto;
    }
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  @media (min-width: 40em) {
    .site-nav {
      column-gap: var(--space-4);
    }
  }

  .site-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    padding-block: var(--space-1);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--color-accent);
  }
</style>
