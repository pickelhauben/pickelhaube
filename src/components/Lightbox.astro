---
/**
 * A simple lightbox built on the native <dialog> element.
 *
 * Any element with `data-lightbox-index` inside `[data-lightbox-gallery]`
 * opens the dialog at that photo. The browser handles focus trapping and
 * Esc to close; this script adds previous/next with arrow keys and buttons.
 * Image URLs and captions come from the `photos` prop, rendered as JSON.
 */
interface Props {
  photos: { src: string; alt: string; caption?: string }[];
}

const { photos } = Astro.props;
---

<dialog class="lightbox" aria-label="Photo viewer" data-photos={JSON.stringify(photos)}>
  <button type="button" class="lightbox__close" data-action="close" aria-label="Close"
    >&times;</button
  >
  <button
    type="button"
    class="lightbox__nav lightbox__nav--prev"
    data-action="prev"
    aria-label="Previous photo">&#8592;</button
  >
  <figure class="lightbox__figure">
    <img class="lightbox__img" src="" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
  <button
    type="button"
    class="lightbox__nav lightbox__nav--next"
    data-action="next"
    aria-label="Next photo">&#8594;</button
  >
</dialog>

<script>
  type Photo = { src: string; alt: string; caption?: string };

  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const gallery = document.querySelector<HTMLElement>('[data-lightbox-gallery]');

  if (dialog && gallery) {
    const photos: Photo[] = JSON.parse(dialog.dataset.photos ?? '[]');
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const triggers = Array.from(gallery.querySelectorAll<HTMLElement>('[data-lightbox-index]'));
    let current = 0;

    function show(index: number) {
      // Wrap around at both ends.
      current = (index + photos.length) % photos.length;
      const photo = photos[current]!;
      img.src = photo.src;
      img.alt = photo.alt;
      caption.textContent = photo.caption ?? '';
      caption.hidden = !photo.caption;
    }

    function open(index: number) {
      show(index);
      dialog!.showModal();
      document.body.style.overflow = 'hidden'; // stop the page scrolling behind
    }

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => open(Number(trigger.dataset.lightboxIndex)));
    }

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'prev') show(current - 1);
      else if (action === 'next') show(current + 1);
      else if (action === 'close' || target === dialog) dialog!.close(); // backdrop click closes
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      // Return focus to the photo that was opened, for keyboard users.
      triggers[current]?.focus();
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.96);
    color: #fff;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    height: 100%;
    padding: var(--space-6) var(--space-4);
    pointer-events: none; /* clicks on empty space reach the dialog and close it */
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    pointer-events: auto;
  }

  .lightbox__caption {
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.8);
    text-align: center;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    font-size: var(--text-lg);
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgb(255 255 255 / 0.25);
  }

  .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--prev {
    left: var(--space-3);
  }

  .lightbox__nav--next {
    right: var(--space-3);
  }

  /* On wider screens, leave room so the photo never sits under the arrows. */
  @media (min-width: 40em) {
    .lightbox__figure {
      padding-inline: 4.5rem;
    }
  }

  .lightbox :focus-visible {
    outline: 2px solid #fff;
  }
</style>
