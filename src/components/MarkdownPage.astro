---
/**
 * Renders one hand-edited Markdown page from src/content/pages/
 * (about, now, resume) with a title, an "updated" date and the body.
 *
 * With `sections`, each ## heading in the Markdown becomes a label in the
 * left rail (good for pages made of several parts, like About). Without it,
 * the body is one reading column beside the "updated" date.
 *
 * Extra content can be passed in the default slot; it appears above the body.
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import Prose from './Prose.astro';
import { formatDate } from '../lib/content';

interface Props {
  /** File name without extension, e.g. "now" for src/content/pages/now.md. */
  page: string;
  description: string;
  /** Optional line shown under the title. */
  intro?: string;
  /** Move each ## heading into the left rail. */
  sections?: boolean;
}

const { page, description, intro, sections = false } = Astro.props;
const entry = await getEntry('pages', page);
if (!entry) throw new Error(`Missing src/content/pages/${page}.md`);
const { Content } = await render(entry);

const isoDate = entry.data.updated.toISOString().slice(0, 10);
const updated = formatDate(entry.data.updated);
---

<Base title={entry.data.title} description={description}>
  <article>
    <PageHeader title={entry.data.title} lede={intro} />

    {
      sections ? (
        <>
          <slot />
          <Prose class="prose--rail">
            <Content />
          </Prose>
          <p class="meta updated">
            Updated <time datetime={isoDate}>{updated}</time>
          </p>
        </>
      ) : (
        <div class="rail body">
          <p class="label">
            Updated <time datetime={isoDate}>{updated}</time>
          </p>
          <div>
            <slot />
            <Prose>
              <Content />
            </Prose>
          </div>
        </div>
      )
    }
  </article>
</Base>

<style>
  .body {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .updated {
    max-width: none;
    margin-top: var(--space-section);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
</style>
