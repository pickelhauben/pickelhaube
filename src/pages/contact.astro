---
/**
 * /contact: email (visible, copyable, with a mailto link) and LinkedIn.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Text from '../components/Text.astro';
import { site, hasEmail } from '../site';
---

<Base
  title="Contact"
  description="How to reach Lawrence Zhang, and what he would like to connect about."
>
  <PageHeader
    title="Contact"
    lede="I’d like to hear from you if you’re working on how institutions shape people, or how people can reshape institutions."
  />

  <Section label="Email" id="email">
    <p class="email">
      <!-- The address is plain text so it can be selected and copied by hand. -->
      <span id="email-address" class="email__address"><Text value={site.email} /></span>
      {
        hasEmail && (
          <>
            <button type="button" class="email__copy" data-copy-target="email-address">
              Copy
            </button>
            <a class="arrow-link" href={`mailto:${site.email}`}>
              Open in mail app
            </a>
          </>
        )
      }
    </p>
    <!-- Announces "Copied" to screen readers without moving focus. -->
    <p id="copy-status" class="meta" role="status" aria-live="polite"></p>
  </Section>

  <Section label="Elsewhere" id="elsewhere">
    <ul class="elsewhere">
      <li>
        {
          site.linkedin ? (
            <a href={site.linkedin} rel="me">
              LinkedIn
            </a>
          ) : (
            <>
              LinkedIn <Text value="[[TODO: profile URL]]" />
            </>
          )
        }
      </li>
      <li>
        {
          site.github ? (
            <a href={site.github} rel="me">
              GitHub
            </a>
          ) : (
            <>
              GitHub <Text value="[[TODO: profile URL]]" />
            </>
          )
        }
      </li>
    </ul>
  </Section>
</Base>

<script>
  // Copy button: use the Clipboard API when available; otherwise select the
  // address so the visitor can press Ctrl/Cmd+C themselves.
  const button = document.querySelector<HTMLButtonElement>('.email__copy');
  const status = document.getElementById('copy-status');

  button?.addEventListener('click', async () => {
    const target = document.getElementById(button.dataset.copyTarget ?? '');
    if (!target || !status) return;
    const text = target.textContent?.trim() ?? '';

    try {
      await navigator.clipboard.writeText(text);
      status.textContent = 'Copied to clipboard.';
    } catch {
      // Fallback: select the text so it can be copied manually.
      const range = document.createRange();
      range.selectNodeContents(target);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      status.textContent = 'Address selected. Press Ctrl+C or Cmd+C to copy.';
    }
  });
</script>

<style>
  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    max-width: none;
  }

  .email__address {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    user-select: all; /* one click selects the whole address */
  }

  /* A placeholder address should stay small, not headline-sized. */
  .email__address :global(.todo) {
    font-size: var(--text-sm);
    letter-spacing: 0;
  }

  .email__copy {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: transparent;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .email__copy:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  #copy-status {
    min-height: 1.6em; /* reserve the line so nothing shifts when text appears */
    margin-top: var(--space-2);
  }

  .elsewhere {
    display: grid;
    gap: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-md);
  }
</style>
