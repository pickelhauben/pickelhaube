---
/**
 * /contact: email (visible, copyable, with a mailto link) and LinkedIn.
 */
import Base from '../layouts/Base.astro';
import { site, hasEmail } from '../site';
---

<Base
  title="Contact"
  description="How to reach Lawrence Zhang, and what he would like to connect about."
>
  <header class="page-header prose-width">
    <h1>Contact</h1>
    <p>
      I’d like to hear from you if you’re working on how institutions shape people, or how people
      can reshape institutions.
    </p>
  </header>

  <section class="prose-width" aria-labelledby="email-heading">
    <h2 id="email-heading">Email</h2>
    <p class="email">
      <!-- The address is plain text so it can be selected and copied by hand. -->
      <span id="email-address" class="email__address">{site.email}</span>
      {
        hasEmail && (
          <>
            <button type="button" class="email__copy" data-copy-target="email-address">
              Copy
            </button>
            <a href={`mailto:${site.email}`}>Open in mail app</a>
          </>
        )
      }
    </p>
    <!-- Announces "Copied" to screen readers without moving focus. -->
    <p id="copy-status" class="meta" role="status" aria-live="polite"></p>
  </section>

  <section class="prose-width" aria-labelledby="elsewhere-heading">
    <h2 id="elsewhere-heading">Elsewhere</h2>
    <ul class="elsewhere">
      <li>
        {
          site.linkedin ? (
            <a href={site.linkedin} rel="me">
              LinkedIn
            </a>
          ) : (
            'LinkedIn [[TODO: profile URL]]'
          )
        }
      </li>
      <li>
        {
          site.github ? (
            <a href={site.github} rel="me">
              GitHub
            </a>
          ) : (
            'GitHub [[TODO: profile URL]]'
          )
        }
      </li>
    </ul>
  </section>
</Base>

<script>
  // Copy button: use the Clipboard API when available; otherwise select the
  // address so the visitor can press Ctrl/Cmd+C themselves.
  const button = document.querySelector<HTMLButtonElement>('.email__copy');
  const status = document.getElementById('copy-status');

  button?.addEventListener('click', async () => {
    const target = document.getElementById(button.dataset.copyTarget ?? '');
    if (!target || !status) return;
    const text = target.textContent?.trim() ?? '';

    try {
      await navigator.clipboard.writeText(text);
      status.textContent = 'Copied to clipboard.';
    } catch {
      // Fallback: select the text so it can be copied manually.
      const range = document.createRange();
      range.selectNodeContents(target);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      status.textContent = 'Address selected. Press Ctrl+C or Cmd+C to copy.';
    }
  });
</script>

<style>
  section + section {
    margin-top: var(--space-7);
  }

  h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .email__address {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
    user-select: all; /* one click selects the whole address */
  }

  .email__copy {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .email__copy:hover {
    border-color: var(--color-text-muted);
  }

  #copy-status {
    min-height: 1.6em; /* reserve the line so nothing shifts when text appears */
    margin-top: var(--space-2);
  }

  .elsewhere {
    padding-left: 1.2em;
  }
</style>
