---
/** Shown for any address that does not exist. */
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <section class="not-found prose-width">
    <p class="meta">404</p>
    <h1>This page isn’t here.</h1>
    <p>
      The link may be old, or the page may have moved. Here are some good places to start again:
    </p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/work">Work</a></li>
      <li><a href="/writing">Writing</a></li>
      <li><a href="/photography">Photography</a></li>
    </ul>
  </section>
</Base>

<style>
  .not-found {
    padding-block: var(--space-7);
  }

  .not-found h1 {
    margin-block: var(--space-2) var(--space-4);
  }

  .not-found ul {
    margin-top: var(--space-4);
    padding-left: 1.2em;
  }

  .not-found li + li {
    margin-top: var(--space-2);
  }
</style>
