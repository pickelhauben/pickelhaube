---
/**
 * /photography: one cover per series, linking to the series page.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPhotoSeries } from '../../lib/content';

const series = await getPhotoSeries();
---

<Base title="Photography" description="Photo series by Lawrence Zhang.">
  <PageHeader
    title="Photography"
    lede="Series, each with a short statement. Open one, then click any photo to view it large."
  />

  <ul class="series-grid">
    {
      series.map((s, index) => {
        const cover = s.data.photos[0];
        return (
          <li class="series-card">
            <a href={`/photography/${s.id}`}>
              {cover && (
                <span class="series-card__frame">
                  <Image
                    src={cover.src}
                    alt={cover.alt}
                    widths={[480, 900, 1350, 1800]}
                    sizes="(min-width: 56em) 38rem, 100vw"
                    format="webp"
                    loading={index < 2 ? 'eager' : 'lazy'}
                  />
                </span>
              )}
              <span class="series-card__text">
                <span class="series-card__title">{s.data.title}</span>
                <span class="meta">
                  {s.data.year} · {s.data.photos.length} photos
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .series-grid {
    display: grid;
    gap: var(--space-7) var(--space-5);
  }

  @media (min-width: 56em) {
    .series-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .series-card {
    max-width: none;
  }

  .series-card a {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  /* The frame clips the photo so it can grow slightly on hover. */
  .series-card__frame {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .series-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .series-card a:hover img {
    transform: scale(1.02);
  }

  .series-card__text {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .series-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    transition: color var(--duration) var(--ease);
  }

  .series-card a:hover .series-card__title {
    color: var(--color-accent);
  }
</style>
