---
/**
 * /writing/<slug>: one essay, set in a centered reading column.
 * Drafts are built only in development.
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Text from '../../components/Text.astro';
import { getPublishedWriting, formatDate, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const essays = await getPublishedWriting();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { title, date, summary, topics, draft, linkedinUrl } = essay.data;
const { Content } = await render(essay);
const isoDate = date.toISOString().slice(0, 10);
---

<Base title={title} description={summary} type="article">
  <article class="essay">
    <header class="essay__header">
      <p class="label">
        <a href="/writing">Writing</a>
        {' / '}
        <time datetime={isoDate}>{formatDate(date)}</time>
        {' / '}
        {readingTime(essay.body)}
        {draft && ' / Draft'}
      </p>
      <h1>{title}</h1>
      <p class="lede"><Text value={summary} /></p>
    </header>

    <Prose class="prose--essay">
      <Content />
    </Prose>

    <footer class="essay__footer">
      <ul class="tags" aria-label="Topics">
        {
          topics.map((topic) => (
            <li>
              <a class="meta" href={`/writing#${encodeURIComponent(topic)}`}>
                {topic}
              </a>
            </li>
          ))
        }
      </ul>
      {
        linkedinUrl && (
          <p>
            <a class="arrow-link" href={linkedinUrl}>
              Also on LinkedIn
            </a>
          </p>
        )
      }
    </footer>
  </article>
</Base>

<style>
  /* A single reading column in the middle of the page. */
  .essay {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .essay__header {
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .essay__header h1 {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .essay__header .lede {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .essay__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
