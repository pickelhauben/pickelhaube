---
/**
 * /writing/<slug>: one essay. Drafts are built only in development.
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedWriting, formatDate, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const essays = await getPublishedWriting();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { title, date, summary, topics, draft, linkedinUrl } = essay.data;
const { Content } = await render(essay);
const isoDate = date.toISOString().slice(0, 10);
---

<Base title={title} description={summary} type="article">
  <article class="essay">
    <header class="essay__header">
      <p class="meta">
        <a href="/writing">Writing</a>
        {' · '}
        <time datetime={isoDate}>{formatDate(date)}</time>
        {' · '}
        {readingTime(essay.body)}
        {draft && <strong> · Draft</strong>}
      </p>
      <h1>{title}</h1>
      <p class="essay__summary">{summary}</p>
    </header>

    <div class="prose prose--essay">
      <Content />
    </div>

    <footer class="essay__footer">
      <ul class="tags" aria-label="Topics">
        {
          topics.map((topic) => (
            <li>
              <a class="meta" href={`/writing#${encodeURIComponent(topic)}`}>
                {topic}
              </a>
            </li>
          ))
        }
      </ul>
      {
        linkedinUrl && (
          <p>
            <a href={linkedinUrl}>Also on LinkedIn</a>, where the conversation happens.
          </p>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .essay {
    max-width: var(--content-width);
  }

  .essay__header {
    margin-bottom: var(--space-6);
  }

  .essay__header h1 {
    margin-top: var(--space-3);
  }

  .essay__summary {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .essay__footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    margin-bottom: var(--space-4);
    list-style: none;
  }
</style>
