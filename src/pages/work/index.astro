---
/**
 * /work: every project as a row in an index, sorted by `order`, with tag filters.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectList from '../../components/ProjectList.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();

// Unique tags across all projects, in order of first appearance.
const tags = [...new Set(projects.flatMap((p) => p.data.tags))];
---

<Base
  title="Work"
  description="Projects and roles: what Lawrence Zhang has built, not just titles held."
>
  <PageHeader title="Work" lede="Things I have built or helped build, and what came of them." />

  <TagFilter tags={tags} target="#work-list" attribute="data-tags" label="Filter by tag" />
  <ProjectList projects={projects} headingLevel="h2" id="work-list" />
</Base>
