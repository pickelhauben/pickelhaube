---
/**
 * Base layout used by every page.
 * Provides the <head> (title, description, Open Graph tags, fonts),
 * the header, the footer and a <main> landmark for page content.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  /** Page title. The site name is appended automatically. */
  title?: string;
  /** One or two sentences for search engines and link previews. */
  description?: string;
  /** Absolute or site-relative URL of the Open Graph image. */
  image?: string;
  /** Open Graph type; essays use "article". */
  type?: 'website' | 'article';
}

const { title, description = site.description, image, type = 'website' } = Astro.props;

// Each page has a generated image at /og/<its path>.png (see src/pages/og/).
// Pages can pass `image` to use something else, such as a photo.
const pathname = Astro.url.pathname.replace(/\/$/, '');
const is404 = pathname === '/404';
const defaultImage = `/og${pathname === '' || is404 ? '/index' : pathname}.png`;

const fontsUrl =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap';

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image ?? defaultImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply a saved theme choice before anything paints (see ThemeToggle.astro).
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · Writing`}
      href="/rss.xml"
    />

    <!-- Open Graph / link previews -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {
      /* Generated images are always 1200×630; photos passed in by a page are not. */
      !image && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {is404 && <meta name="robots" content="noindex" />}

    <!--
      Fonts: a serif for headings and essays, a sans for the interface.
      The stylesheet is loaded with media="print" and switched to "all" once
      it arrives, so it never blocks the first paint. Until then the system
      fallback fonts in tokens.css are shown (display=swap does the same for
      the font files themselves). Without JavaScript, <noscript> loads it normally.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link id="fonts-css" rel="stylesheet" href={fontsUrl} media="print" />
    <script is:inline>
      // Switch the font stylesheet from "print" to "all" as soon as it has loaded.
      (function () {
        var link = document.getElementById('fonts-css');
        function enable() {
          link.media = 'all';
        }
        if (link.sheet) enable();
        else link.addEventListener('load', enable);
      })();
    </script>
    <noscript><link rel="stylesheet" href={fontsUrl} /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
